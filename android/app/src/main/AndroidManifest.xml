<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        HARD REQUIREMENT: zero <uses-permission> entries.
        This app has no INTERNET permission and no network capability at all.

        NOTE: android:extractNativeLibraries="false" is intentionally absent:
        the vendor-trimmed SDK platform android-34 on this host lacks the
        attribute definition and aapt2 rejects it. It is a functional no-op
        here because the APK contains no native libraries.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Breakout">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
